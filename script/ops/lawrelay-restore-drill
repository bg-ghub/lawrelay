#!/usr/bin/env sh
# Read-only restore verification. Never writes into the production volume.
set -eu
umask 077

root=${LAWRELAY_RESTORE_DRILL_ROOT:-/var/lib/lawrelay-restore-drills}
tag=${LAWRELAY_LOG_TAG:-lawrelay-restore-drill}

log() { if command -v logger >/dev/null 2>&1; then logger -t "$tag" -- "$*"; fi; printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
fail() { log "restore drill failed: $*"; exit 1; }
for command in restic sqlite3 tar; do command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"; done
[ -n "${RESTIC_REPOSITORY:-}" ] || fail "RESTIC_REPOSITORY is not configured"
[ -n "${RESTIC_PASSWORD_FILE:-}" ] || fail "RESTIC_PASSWORD_FILE is not configured"
[ -r "$RESTIC_PASSWORD_FILE" ] || fail "RESTIC_PASSWORD_FILE is not readable"

mkdir -p "$root"
chmod 700 "$root"
drill=$(mktemp -d "$root/drill.XXXXXX") || fail "could not create isolated restore directory"
cleanup() { rm -rf "$drill"; }
trap cleanup EXIT HUP INT TERM

# A repository may hold other data. Never restore an unrelated most-recent
# snapshot merely because it happened to be newer than the LawRelay backup.
restic restore --tag lawrelay latest --target "$drill" || fail "restic restore failed"
[ -f "$drill/manifest" ] || fail "restored snapshot is not a LawRelay backup"

for database in production.sqlite3 production_queue.sqlite3 production_cable.sqlite3; do
  db="$drill/databases/$database"
  [ -f "$db" ] || fail "restored database is missing: $database"
  [ "$(sqlite3 -readonly "$db" 'PRAGMA integrity_check;')" = "ok" ] || fail "integrity check failed: $database"
done
[ -f "$drill/storage.tar" ] || fail "restored storage archive is missing"
tar -tf "$drill/storage.tar" >/dev/null || fail "storage archive cannot be read"
log "restore drill completed; isolated data removed"
