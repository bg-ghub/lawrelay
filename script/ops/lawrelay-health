#!/usr/bin/env sh
# Checks public reachability and the local recovery signals for a small host.
set -eu
umask 077

base_url=${LAWRELAY_BASE_URL:-https://lawrelay.be}
volume=${LAWRELAY_STORAGE_VOLUME:-lawrelay_storage}
state_dir=${LAWRELAY_BACKUP_STATE_DIR:-/var/lib/lawrelay-backup/state}
max_backup_age_hours=${LAWRELAY_BACKUP_MAX_AGE_HOURS:-26}
mail_state_dir=${LAWRELAY_MAIL_RETENTION_STATE_DIR:-}
max_mail_age_hours=${LAWRELAY_MAIL_RETENTION_MAX_AGE_HOURS:-50}
disk_warn_percent=${LAWRELAY_DISK_WARN_PERCENT:-85}
container=${LAWRELAY_DOCKER_CONTAINER:-}
umami_db_container=${LAWRELAY_UMAMI_DB_CONTAINER:-}
umami_app_container=${LAWRELAY_UMAMI_APP_CONTAINER:-}
notify=${LAWRELAY_NOTIFY_COMMAND:-/usr/local/libexec/lawrelay-notify}
notify_direct=${LAWRELAY_NOTIFY_DIRECT:-false}
tag=${LAWRELAY_LOG_TAG:-lawrelay-health}

log() { if command -v logger >/dev/null 2>&1; then logger -t "$tag" -- "$*"; fi; printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
fail() {
  log "health check failed: $*"
  # systemd OnFailure is the default notification route. Direct delivery is
  # available only for intentionally non-systemd/manual operation.
  [ "$notify_direct" = true ] && [ -x "$notify" ] && "$notify" "LawRelay health check failed on $(hostname): $*" || true
  exit 1
}
for command in awk curl docker df find grep sqlite3; do command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"; done

# Rails' built-in /up is an HTML liveness response. /ready is LawRelay's
# machine-readable readiness endpoint, so only it has a JSON body contract.
curl --fail --silent --show-error --max-time 15 "$base_url/up" >/dev/null || fail "HTTPS endpoint unavailable: /up"
response=$(curl --fail --silent --show-error --max-time 15 "$base_url/ready") || fail "HTTPS endpoint unavailable: /ready"
printf '%s' "$response" | grep -q '"status":"ok"' || fail "endpoint unhealthy: /ready"
response=$(curl --fail --silent --show-error --max-time 15 "$base_url/health/operations") || fail "notification or queue operations unavailable"
printf '%s' "$response" | grep -q '"status":"ok"' || fail "notification or queue operations unhealthy"

mountpoint=$(docker volume inspect --format '{{ .Mountpoint }}' "$volume" 2>/dev/null) || fail "Docker volume not found: $volume"
[ -d "$mountpoint" ] || fail "volume mountpoint is unavailable"
used=$(df -P "$mountpoint" | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }')
[ -n "$used" ] || fail "could not read disk usage"
[ "$used" -lt "$disk_warn_percent" ] || fail "disk usage is ${used}% (threshold ${disk_warn_percent}%)"

last_success="$state_dir/last-success"
[ -f "$last_success" ] || fail "backup success marker is missing"
max_age_minutes=$((max_backup_age_hours * 60))
find "$last_success" -mmin "+$max_age_minutes" -print -quit | grep -q . && fail "latest backup is older than ${max_backup_age_hours}h"

if [ -n "$mail_state_dir" ]; then
  mail_success="$mail_state_dir/last-success"
  [ -f "$mail_success" ] || fail "mailbox cleanup success marker is missing"
  max_mail_age_minutes=$((max_mail_age_hours * 60))
  find "$mail_success" -mmin "+$max_mail_age_minutes" -print -quit | grep -q . && fail "mailbox cleanup is older than ${max_mail_age_hours}h"
fi

queue_db="$mountpoint/production_queue.sqlite3"
[ -f "$queue_db" ] || fail "queue database is missing"
[ "$(sqlite3 -readonly "$queue_db" 'PRAGMA quick_check;')" = "ok" ] || fail "queue database quick check failed"
failed_jobs=$(sqlite3 -readonly "$queue_db" 'SELECT COUNT(*) FROM solid_queue_failed_executions;') || fail "could not count failed queue jobs"
[ "$failed_jobs" -eq 0 ] 2>/dev/null || fail "queue has failed executions"
stuck_jobs=$(sqlite3 -readonly "$queue_db" "
  SELECT COUNT(*) FROM (
    SELECT created_at AS due_at FROM solid_queue_ready_executions
    UNION ALL
    SELECT scheduled_at AS due_at FROM solid_queue_scheduled_executions
      WHERE scheduled_at <= CURRENT_TIMESTAMP
  ) WHERE due_at < datetime('now', '-15 minutes');
") || fail "could not count due queue jobs"
[ "$stuck_jobs" -eq 0 ] 2>/dev/null || fail "queue has due executions older than 15 minutes"

if [ -n "$container" ]; then
  [ "$(docker inspect --format '{{.State.Running}}' "$container" 2>/dev/null || true)" = "true" ] || fail "application container is not running"
fi

# Keep this optional while LawRelay is not running its own Umami instance.
# A configured analytics backup must have the same healthy pair as this check.
if [ -n "$umami_db_container" ] || [ -n "$umami_app_container" ]; then
  [ -n "$umami_db_container" ] && [ -n "$umami_app_container" ] || fail "Umami health configuration is incomplete"
  [ "$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$umami_db_container" 2>/dev/null || true)" = healthy ] || fail "Umami database container is not healthy"
  [ "$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$umami_app_container" 2>/dev/null || true)" = healthy ] || fail "Umami application container is not healthy"
  response=$(curl --fail --silent --show-error --max-time 15 https://analytics.lawrelay.be/api/heartbeat) || fail "Umami heartbeat is unavailable"
  printf '%s' "$response" | grep -q '"ok":true' || fail "Umami heartbeat is unhealthy"
fi
log "health check passed"
