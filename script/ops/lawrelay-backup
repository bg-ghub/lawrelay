#!/usr/bin/env sh
# Encrypted off-host backup for a single Docker-hosted LawRelay instance.
set -eu
umask 077

volume=${LAWRELAY_STORAGE_VOLUME:-lawrelay_storage}
work_root=${LAWRELAY_BACKUP_WORK_ROOT:-/var/lib/lawrelay-backup}
state_dir=${LAWRELAY_BACKUP_STATE_DIR:-$work_root/state}
lock_file=${LAWRELAY_BACKUP_LOCK_FILE:-$work_root/backup.lock}
ledger_dir=${LAWRELAY_ERASURE_LEDGER_DIR:-/var/lib/lawrelay-privacy}
ledger=${LAWRELAY_ERASURE_LEDGER:-$ledger_dir/erasures.jsonl}
ledger_lock=${LAWRELAY_ERASURE_LEDGER_LOCK:-$ledger.lock}
mail_state_dir=${LAWRELAY_MAIL_RETENTION_STATE_DIR:-/var/lib/lawrelay-mail-retention}
umami_db_container=${LAWRELAY_UMAMI_DB_CONTAINER:-}
umami_app_container=${LAWRELAY_UMAMI_APP_CONTAINER:-}
umami_config_dir=${LAWRELAY_UMAMI_CONFIG_DIR:-/home/deploy/lawrelay}
notify=${LAWRELAY_NOTIFY_COMMAND:-/usr/local/libexec/lawrelay-notify}
notify_direct=${LAWRELAY_NOTIFY_DIRECT:-false}
tag=${LAWRELAY_LOG_TAG:-lawrelay-backup}

log() {
  if command -v logger >/dev/null 2>&1; then logger -t "$tag" -- "$*"; fi
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"
}
fail() {
  log "backup failed: $*"
  # systemd OnFailure provides the normal, single alert path.
  [ "$notify_direct" = true ] && [ -x "$notify" ] && "$notify" "LawRelay backup failed on $(hostname): $*" || true
  exit 1
}

for command in docker flock sqlite3 restic tar cp stat; do command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"; done
[ -n "${RESTIC_REPOSITORY:-}" ] || fail "RESTIC_REPOSITORY is not configured"
[ -n "${RESTIC_PASSWORD_FILE:-}" ] || fail "RESTIC_PASSWORD_FILE is not configured"
[ -r "$RESTIC_PASSWORD_FILE" ] || fail "RESTIC_PASSWORD_FILE is not readable"

mkdir -p "$work_root" "$state_dir"
chmod 700 "$work_root" "$state_dir"
exec 9>"$lock_file"
flock -n 9 || { log "backup already running; skipping"; exit 0; }

mountpoint=$(docker volume inspect --format '{{ .Mountpoint }}' "$volume" 2>/dev/null) || fail "Docker volume not found: $volume"
[ -d "$mountpoint" ] || fail "volume mountpoint is unavailable"

# The erasure ledger deliberately lives outside the volume. Take the same lock
# as the app and snapshot it as a separate artifact, so recovery can use the
# newest successful ledger even when the chosen database snapshot is older.
[ ! -L "$ledger_dir" ] && [ -d "$ledger_dir" ] || fail "erasure ledger directory is unsafe"
[ "$(stat -c '%u:%g:%a' "$ledger_dir")" = '1000:1000:700' ] || fail "erasure ledger directory permissions are unsafe"
[ ! -L "$ledger" ] && [ -f "$ledger" ] || fail "erasure ledger file is unsafe"
[ ! -L "$ledger_lock" ] && [ -f "$ledger_lock" ] || fail "erasure ledger lock is unsafe"
[ "$(stat -c '%u:%g:%a:%h' "$ledger")" = '1000:1000:600:1' ] || fail "erasure ledger file permissions are unsafe"
[ "$(stat -c '%u:%g:%a:%h' "$ledger_lock")" = '1000:1000:600:1' ] || fail "erasure ledger lock permissions are unsafe"

stage=$(mktemp -d "$work_root/stage.XXXXXX") || fail "could not create staging directory"
cleanup() { rm -rf "$stage"; }
trap cleanup EXIT HUP INT TERM
mkdir -p "$stage/databases"

backup_db() {
  name=$1
  source="$mountpoint/$name"
  destination="$stage/databases/$name"
  [ -f "$source" ] || fail "expected database is missing: $name"
  # SQLite's backup API makes a consistent copy without stopping the app.
  sqlite3 "$source" ".backup '$destination'" || fail "SQLite backup failed for $name"
  [ "$(sqlite3 -readonly "$destination" 'PRAGMA integrity_check;')" = "ok" ] || fail "integrity check failed for $name"
}

backup_db production.sqlite3
backup_db production_queue.sqlite3
backup_db production_cable.sqlite3

container_healthy() {
  [ "$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$1" 2>/dev/null || true)" = healthy ]
}

# Analytics backups are enabled explicitly so existing single-SQLite deployments
# and restore drills keep their current behavior. Once either container name is configured, both
# protected runtime env files and both healthy containers are mandatory.
umami_enabled=false
if [ -n "$umami_db_container" ] || [ -n "$umami_app_container" ]; then
  [ -n "$umami_db_container" ] && [ -n "$umami_app_container" ] || fail "Umami backup configuration is incomplete"
  container_healthy "$umami_db_container" || fail "Umami database container is not healthy"
  container_healthy "$umami_app_container" || fail "Umami application container is not healthy"

  mkdir -p "$stage/analytics"
  for umami_file in umami.env umami-db.env; do
    source="$umami_config_dir/$umami_file"
    [ ! -L "$source" ] && [ -f "$source" ] || fail "Umami configuration file is unsafe: $umami_file"
    [ "$(stat -c '%U:%a:%h' "$source")" = 'deploy:600:1' ] || fail "Umami configuration file permissions are unsafe: $umami_file"
    cp -- "$source" "$stage/analytics/$umami_file" || fail "could not stage Umami configuration: $umami_file"
    chmod 600 "$stage/analytics/$umami_file"
  done

  # Postgres credentials remain inside the container environment. The custom
  # archive is checked before restic can send it off-host.
  docker exec "$umami_db_container" sh -ec '
    exec pg_dump --format=custom --no-owner --no-privileges -U "$POSTGRES_USER" -d "$POSTGRES_DB"
  ' >"$stage/analytics/database.dump" || fail "Umami PostgreSQL dump failed"
  [ -s "$stage/analytics/database.dump" ] || fail "Umami PostgreSQL dump is empty"
  docker exec -i "$umami_db_container" pg_restore --list <"$stage/analytics/database.dump" >/dev/null || fail "Umami PostgreSQL dump validation failed"
  umami_enabled=true
fi

# Copy after the database snapshots so their committed erasures are included.
exec 8<"$ledger_lock"
flock -s 8 || fail "could not lock erasure ledger"
cp -- "$ledger" "$stage/erasures.jsonl" || fail "erasure ledger copy failed"
chmod 600 "$stage/erasures.jsonl"
flock -u 8

# Persist closure timestamps without copying message bodies or credentials.
if [ -e "$mail_state_dir/state.json" ]; then
  [ ! -L "$mail_state_dir" ] && [ -d "$mail_state_dir" ] || fail "mail retention state directory is unsafe"
  [ "$(stat -c '%u:%g:%a' "$mail_state_dir")" = '0:0:700' ] || fail "mail retention state directory permissions are unsafe"
  for mail_file in "$mail_state_dir/state.json" "$mail_state_dir/state.json.lock"; do
    [ ! -L "$mail_file" ] && [ -f "$mail_file" ] || fail "mail retention state file is unsafe"
    [ "$(stat -c '%u:%g:%a:%h' "$mail_file")" = '0:0:600:1' ] || fail "mail retention state permissions are unsafe"
  done
  exec 7<"$mail_state_dir/state.json.lock"
  flock -s 7 || fail "could not lock mail retention state"
  cp -- "$mail_state_dir/state.json" "$stage/mail-retention-state.json" || fail "mail retention state copy failed"
  chmod 600 "$stage/mail-retention-state.json"
  flock -u 7
fi

# Cache is intentionally omitted: Rails can recreate it. Archive uploaded files
# and any other persistent storage while excluding live SQLite/WAL files.
tar -C "$mountpoint" \
  --exclude='production*.sqlite3' --exclude='production*.sqlite3-*' \
  --exclude='tmp' --exclude='backups' \
  -cf "$stage/storage.tar" . || fail "storage archive failed"

printf '%s\n' "created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$stage/manifest"
printf '%s\n' "volume=$volume" >>"$stage/manifest"
printf '%s\n' "databases=production.sqlite3,production_queue.sqlite3,production_cable.sqlite3" >>"$stage/manifest"
printf '%s\n' "erasure_ledger=erasures.jsonl" >>"$stage/manifest"
[ "$umami_enabled" = false ] || printf '%s\n' "analytics=analytics/database.dump,analytics/umami.env,analytics/umami-db.env" >>"$stage/manifest"

set -- databases storage.tar erasures.jsonl manifest
[ ! -f "$stage/mail-retention-state.json" ] || set -- "$@" mail-retention-state.json
[ "$umami_enabled" = false ] || set -- "$@" analytics
(cd "$stage" && restic backup --tag lawrelay --tag sqlite-online --tag "host-$(hostname)" "$@") || fail "restic backup failed"
restic snapshots --tag lawrelay --latest 1 --json >/dev/null || fail "could not verify LawRelay restic snapshot"
# Keep recovery copies for 30 days. The fresh snapshot above must succeed before
# pruning starts, so a retention run cannot remove the only recent backup.
restic forget --group-by host,tags --tag lawrelay --keep-within 30d --prune || fail "restic retention failed"

date -u +%Y-%m-%dT%H:%M:%SZ >"$state_dir/last-success"
chmod 600 "$state_dir/last-success"
log "backup completed"
