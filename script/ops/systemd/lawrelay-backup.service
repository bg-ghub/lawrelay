[Unit]
Description=LawRelay encrypted backup
After=docker.service network-online.target
Wants=network-online.target
OnFailure=lawrelay-failure@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/lawrelay/backup.env
ExecStart=/usr/local/libexec/lawrelay-backup
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
