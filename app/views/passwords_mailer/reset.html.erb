<h1><%= t("auth.mailers.password_reset.heading", name: @user.first_name) %></h1>
<p><%= t("auth.mailers.password_reset.body") %></p>
<p><%= link_to t("auth.mailers.password_reset.action"), @reset_url %></p>
<p><%= t("auth.mailers.password_reset.expiry", duration: distance_of_time_in_words(0, @user.password_reset_token_expires_in)) %></p>
