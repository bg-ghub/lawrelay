<% content_for :title, t("auth.registration.title") %>
<div class="new-assignment shell account-flow-page">
  <div class="new-assignment__intro">
    <h1><%= t("auth.registration.heading") %></h1>
  </div>

  <div class="new-assignment__layout auth-form-layout">
    <%= form_with scope: :registration, url: registration_path, class: "assignment-form", data: {
      controller: "registration-profile",
      registration_profile_url_value: registration_profile_path,
      registration_profile_fetch_label_value: t("signup_profile.fetch"),
      registration_profile_loading_value: t("signup_profile.loading"),
      registration_profile_loaded_value: t("signup_profile.loaded"),
      registration_profile_unavailable_value: t("signup_profile.errors.unavailable"),
      registration_profile_stale_value: t("signup_profile.stale"),
      registration_profile_ready_value: @directory_identity.present?,
      registration_profile_imported_name_value: @directory_identity&.fetch("name", "").to_s,
      registration_profile_listed_email_value: @directory_identity&.fetch("email_address", "").to_s
    } do |form| %>
      <%= form.hidden_field :directory_preview_token, value: @form_values["directory_preview_token"], data: { registration_profile_target: "token" } %>
      <% if @registration_errors.any? %>
        <div class="form-error" role="alert" tabindex="-1" data-controller="form-errors">
          <strong><%= t("auth.registration.error_heading") %></strong>
          <ul><% @registration_errors.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>

      <fieldset class="form-section">
        <legend><%= t("directory_onboarding.registration.legend") %></legend>
        <div class="field-group">
          <%= form.label :directory_profile_url, t("directory_onboarding.registration.profile_url") %>
          <%= form.url_field :directory_profile_url, required: true, value: @form_values["directory_profile_url"], placeholder: "https://www.advocaat.be/...", inputmode: "url", autocomplete: "off", aria: { describedby: "registration-directory-hint registration-profile-status" }, data: { registration_profile_target: "url", action: "input->registration-profile#urlChanged keydown.enter->registration-profile#lookup" } %>
          <p class="field-hint" id="registration-directory-hint"><%= t("signup_profile.hint") %></p>
          <p class="field-hint"><%= link_to t("directory_onboarding.registration.find_profile"), "https://www.advocaat.be/nl/zoek-een-advocaat", target: "_blank", rel: "noopener noreferrer", class: "text-link" %></p>
        </div>
        <div class="registration-profile__actions">
          <%= form.button t("signup_profile.fetch"), type: "submit", formaction: registration_profile_path, formmethod: "post", formnovalidate: true, class: "button button--dark", data: { registration_profile_target: "fetch", action: "click->registration-profile#lookup" } %>
          <p class="registration-profile__signin" <%= "hidden" if @directory_identity %> data-registration-profile-target="initial"><%= link_to t("auth.actions.already_registered"), new_session_path, class: "text-link" %></p>
        </div>
        <p class="field-hint registration-profile__status" id="registration-profile-status" role="status" aria-live="polite" data-registration-profile-target="status"></p>
      </fieldset>

      <fieldset class="form-section" <%= 'hidden disabled' unless @directory_identity %> data-registration-profile-target="details">
        <legend><%= t("auth.registration.identity") %></legend>
        <div class="registration-profile__summary">
          <strong data-registration-profile-target="summaryName"><%= @directory_identity&.fetch("name", "") %></strong>
        </div>
        <div class="field-group">
          <%= label_tag :registration_username, t("signup_profile.listed_email") %>
          <%= email_field_tag :username, @directory_identity&.fetch("email_address", ""), id: "registration_username", readonly: true, autocomplete: "username", class: "registration-profile__email", data: { registration_profile_target: "summaryEmail" } %>
          <p class="field-hint registration-profile__listed-email-notice"><%= t("signup_profile.confirm_email") %></p>
          <%= advocaat_webmail_hint(@directory_identity&.fetch("email_address", ""), registration: true) %>
        </div>
        <div class="field-group registration-profile__email-choice">
          <label class="toggle-row"><%= form.check_box :request_alternative_email, { checked: @request_alternative_email }, "1", "0" %><span><%= t("signup_profile.alternative_email") %></span></label>
          <p class="field-hint"><%= t("signup_profile.alternative_email_hint") %></p>
        </div>
        <div class="form-row">
          <div class="field-group"><%= form.label :password, t("auth.fields.password") %><%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %></div>
          <div class="field-group"><%= form.label :password_confirmation, t("auth.fields.password_confirmation") %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %></div>
        </div>
        <%= form.hidden_field :locale, value: I18n.locale %>
      </fieldset>

      <fieldset class="form-section" <%= 'hidden disabled' unless @directory_identity %> data-registration-profile-target="details">
        <legend><%= t("auth.registration.agreement") %></legend>
        <label class="toggle-row">
          <%= form.check_box :terms_accepted, { required: true, checked: @terms_accepted }, "1", "0" %>
          <span>
            <%= t("auth.registration.agreement_html", terms: link_to(t("auth.registration.terms"), terms_path, class: "text-link"), privacy: link_to(t("auth.registration.privacy"), privacy_path, class: "text-link")) %>
          </span>
        </label>
      </fieldset>

      <div class="form-actions" <%= 'hidden' unless @directory_identity %> data-registration-profile-target="details">
        <%= link_to t("auth.actions.already_registered"), new_session_path, class: "button button--ghost" %>
        <%= form.submit t("auth.registration.submit"), class: "button button--dark" %>
      </div>
    <% end %>
  </div>
</div>
