<header class="site-header" data-controller="mobile-nav" data-action="keydown.esc@window->mobile-nav#close click@window->mobile-nav#closeOutside focusout->mobile-nav#closeOnFocusOut resize@window->mobile-nav#reset turbo:before-cache@document->mobile-nav#reset">
  <div class="shell header-inner">
    <%= link_to root_path, class: "brand", aria: { label: t("marketing.header.home_label") } do %>
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Law<span>Relay</span></span>
    <% end %>

    <nav id="primary-navigation" class="primary-nav" aria-label="<%= t("marketing.header.primary_navigation") %>" data-mobile-nav-target="menu">
      <%= link_to t("marketing.header.how_it_works"), root_path(anchor: "how-it-works"), data: { action: "mobile-nav#close" } %>
      <%= link_to t("marketing.header.for_lawyers"), root_path(anchor: "for-lawyers"), data: { action: "mobile-nav#close" } %>
      <%= link_to t("marketing.header.discover_assignments"), assignments_path, data: { action: "mobile-nav#close" } %>
      <%= link_to t("pages.navigation.pricing"), pricing_path, data: { action: "mobile-nav#close" } if platform_billing_enabled? %>
      <%= link_to t("marketing.header.questions"), root_path(anchor: "questions"), data: { action: "mobile-nav#close" } %>
      <% if authenticated? %>
        <% if current_user.system_admin? %>
          <%= link_to t("admin.users.link"), admin_users_path, class: "mobile-nav-only", data: { action: "mobile-nav#close" } %>
        <% else %>
          <%= link_to t("marketing.header.dashboard"), dashboard_path, class: "mobile-nav-only", data: { action: "mobile-nav#close" } %>
        <% end %>
        <%= button_to t("auth.sessions.sign_out"), session_path, method: :delete, class: "mobile-nav-action mobile-nav-only" %>
      <% else %>
        <%= link_to t("auth.sessions.submit"), new_session_path, class: "mobile-nav-only", data: { action: "mobile-nav#close" } %>
        <%= link_to t("auth.sessions.create_account"), new_registration_path, class: "mobile-nav-only", data: { action: "mobile-nav#close" } %>
      <% end %>
    </nav>

    <div class="header-actions">
      <%= render "shared/language_menu" %>
      <% if authenticated? %>
        <%= link_to current_user.full_name, (current_user.system_admin? ? admin_users_path : settings_path), class: "header-login" %>
        <%= button_to t("auth.sessions.sign_out"), session_path, method: :delete, class: "header-logout header-login" %>
        <% if current_user.system_admin? %>
          <%= link_to t("admin.users.link"), admin_users_path, class: "button button-small button-dark" %>
        <% elsif current_user.marketplace_verified? %>
          <%= link_to new_assignment_path, class: "button button-small button-dark" do %>
            <span><%= t("marketing.actions.post_assignment") %></span>
            <span aria-hidden="true">↗</span>
          <% end %>
        <% else %>
          <%= link_to t("auth.verification_status.eyebrow"), verification_status_path, class: "button button-small button-dark" %>
        <% end %>
      <% else %>
        <%= link_to t("auth.sessions.submit"), new_session_path, class: "header-login" %>
        <%= link_to t("auth.sessions.create_account"), new_registration_path, class: "button button-small button-dark" %>
      <% end %>
      <button class="menu-toggle" type="button" aria-label="<%= t("marketing.header.open_menu") %>" aria-controls="primary-navigation" aria-expanded="false" data-mobile-nav-target="button" data-action="mobile-nav#toggle">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
