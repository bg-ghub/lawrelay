<header class="site-header" data-controller="mobile-nav" data-action="keydown.esc@window->mobile-nav#close">
  <div class="shell header-inner">
    <%= link_to root_path, class: "brand", aria: { label: t("marketing.header.home_label") } do %>
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Law<span>Relay</span></span>
    <% end %>

    <nav class="primary-nav" aria-label="<%= t("marketing.header.primary_navigation") %>" data-mobile-nav-target="menu">
      <%= link_to t("marketing.header.how_it_works"), root_path(anchor: "how-it-works"), data: { action: "mobile-nav#close" } %>
      <%= link_to t("marketing.header.for_lawyers"), root_path(anchor: "for-lawyers"), data: { action: "mobile-nav#close" } %>
      <%= link_to t("marketing.header.discover_assignments"), assignments_path, data: { action: "mobile-nav#close" } %>
      <%= link_to t("pages.navigation.pricing"), pricing_path, data: { action: "mobile-nav#close" } %>
      <%= link_to t("marketing.header.questions"), root_path(anchor: "questions"), data: { action: "mobile-nav#close" } %>
      <% if authenticated? %>
        <%= link_to t("marketing.header.dashboard"), dashboard_path, class: "mobile-nav-only", data: { action: "mobile-nav#close" } %>
        <%= button_to t("auth.sessions.sign_out"), session_path, method: :delete, class: "mobile-nav-action mobile-nav-only" %>
      <% else %>
        <%= link_to t("auth.sessions.submit"), new_session_path, class: "mobile-nav-only", data: { action: "mobile-nav#close" } %>
        <%= link_to t("auth.sessions.create_account"), new_registration_path, class: "mobile-nav-only", data: { action: "mobile-nav#close" } %>
      <% end %>
    </nav>

    <div class="header-actions">
      <nav class="language-nav" aria-label="<%= t("marketing.language_switcher") %>">
        <details class="language-menu">
          <summary aria-label="<%= t("marketing.language_switcher") %>">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9S14.4 18.5 12 21c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z"></path>
            </svg>
            <span><%= I18n.locale.to_s.upcase %></span>
            <span class="language-menu__chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="language-menu__panel">
            <% locale_names = { nl: "Nederlands", fr: "Français", de: "Deutsch", en: "English" } %>
            <% %i[nl fr de en].each do |locale| %>
              <% item_class = ["language-menu__item", ("is-current" if I18n.locale == locale)].compact.join(" ") %>
              <% if I18n.locale == locale %>
                <span class="<%= item_class %>" lang="<%= locale %>" aria-current="page">
                  <strong><%= locale.to_s.upcase %></strong><span><%= locale_names.fetch(locale) %></span><span aria-hidden="true">✓</span>
                </span>
              <% else %>
                <%= link_to url_for(locale: locale), class: item_class, lang: locale, hreflang: locale do %>
                  <strong><%= locale.to_s.upcase %></strong><span><%= locale_names.fetch(locale) %></span><span></span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </details>
      </nav>
      <% if authenticated? %>
        <%= link_to current_user.full_name, settings_path, class: "header-login" %>
        <%= button_to t("auth.sessions.sign_out"), session_path, method: :delete, class: "header-logout header-login" %>
        <% if current_user.marketplace_verified? %>
          <%= link_to new_assignment_path, class: "button button-small button-dark" do %>
            <span><%= t("marketing.actions.post_assignment") %></span>
            <span aria-hidden="true">↗</span>
          <% end %>
        <% else %>
          <%= link_to t("auth.verification_status.eyebrow"), verification_status_path, class: "button button-small button-dark" %>
        <% end %>
      <% else %>
        <%= link_to t("auth.sessions.submit"), new_session_path, class: "header-login" %>
        <%= link_to t("auth.sessions.create_account"), new_registration_path, class: "button button-small button-dark" %>
      <% end %>
      <button class="menu-toggle" type="button" aria-label="<%= t("marketing.header.open_menu") %>" aria-expanded="false" data-mobile-nav-target="button" data-action="mobile-nav#toggle">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
