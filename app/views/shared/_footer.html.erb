<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-intro">
      <%= link_to root_path, class: "brand brand-light", aria: { label: t("marketing.header.home_label") } do %>
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>Law<span>Relay</span></span>
      <% end %>
      <p><%= t("marketing.footer.intro") %></p>
      <div class="footer-project">
        <%= link_to "https://github.com/bg-ghub/lawrelay", class: "footer-project__source", target: "_blank", rel: "noopener noreferrer" do %>
          <%= t("marketing.footer.source_code") %> <span aria-hidden="true">↗</span>
        <% end %>
        <span class="footer-project__license"><%= t("marketing.footer.open_source") %> · AGPL-3.0+</span>
        <span class="footer-project__version"><%= t("marketing.footer.app_version", version: LawRelay::VERSION) %></span>
      </div>
    </div>
    <div class="footer-column">
      <p class="footer-label"><%= t("marketing.footer.platform") %></p>
      <%= link_to t("marketing.header.discover_assignments"), assignments_path %>
      <%= link_to t("marketing.actions.post_assignment"), new_assignment_path %>
      <%= link_to t("marketing.header.dashboard"), dashboard_path %>
    </div>
    <div class="footer-column">
      <p class="footer-label"><%= t("marketing.footer.learn_more") %></p>
      <%= link_to t("pages.navigation.pricing"), pricing_path if platform_billing_enabled? %>
      <%= link_to t("pages.navigation.privacy"), privacy_path %>
      <%= link_to t("pages.navigation.terms"), terms_path %>
      <%= link_to t("pages.navigation.cookies"), cookies_path %>
      <%= link_to t("pages.navigation.legal_notice"), legal_notice_path %>
    </div>
    <div class="footer-column">
      <p class="footer-label"><%= t("marketing.footer.contact") %></p>
      <%= mail_to "info@lawrelay.be", "info@lawrelay.be" %>
      <p class="footer-label"><%= t("marketing.footer.made_for_belgium") %></p>
      <p class="footer-note"><%= t("marketing.footer.demo_notice") %></p>
    </div>
  </div>
  <div class="shell footer-bottom">
    <p>© <%= Date.current.year %> LawRelay</p>
    <p><%= t("marketing.footer.demo_disclaimer") %></p>
  </div>
</footer>
