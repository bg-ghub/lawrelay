<section class="analytics-preference" data-analytics-preference-panel data-analytics-privacy-signal-message="<%= t("marketing.analytics.privacy_signal") %>" role="region" aria-labelledby="analytics-preference-title" hidden>
  <div class="analytics-preference__inner">
    <div>
      <p class="analytics-preference__title" id="analytics-preference-title"><%= t("marketing.analytics.title") %></p>
      <p class="analytics-preference__copy">
        <%= t("marketing.analytics.copy") %>
        <%= link_to t("marketing.analytics.details"), cookies_path, class: "analytics-preference__details" %>
      </p>
      <p class="analytics-preference__status" data-analytics-preference-status hidden></p>
    </div>
    <div class="analytics-preference__controls">
      <button class="button button--small button--outline analytics-preference__dismiss" type="button" data-analytics-dismiss-banner><%= t("marketing.analytics.dismiss") %></button>
      <div class="analytics-preference__actions" data-analytics-preference-actions hidden>
        <button class="button button--small button--outline" type="button" data-analytics-preference="deny"><%= t("marketing.analytics.disable") %></button>
        <button class="button button--small button--outline" type="button" data-analytics-preference="allow"><%= t("marketing.analytics.enable") %></button>
      </div>
    </div>
  </div>
</section>
