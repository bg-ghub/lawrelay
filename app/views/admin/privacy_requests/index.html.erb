<% content_for :title, t("trust.admin.privacy_requests.title") %>
<main class="dashboard-page shell trust-page">
  <div class="dashboard-heading"><div><p class="eyebrow"><%= t("trust.admin.eyebrow") %></p><h1><%= t("trust.admin.privacy_requests.heading") %></h1><p><%= t("trust.admin.privacy_requests.lede") %></p></div><%= link_to t("trust.admin.reports.heading"), admin_reports_path, class: "button button--ghost" %></div>
  <section class="dashboard-panel">
    <% if @privacy_requests.any? %>
      <div class="trust-list"><% @privacy_requests.each do |request_record| %><article class="trust-row trust-row--admin"><div><strong><%= t("trust.privacy_requests.kinds.#{request_record.kind}") %></strong><p><%= request_record.user.full_name %> · <%= request_record.user.email_address %></p><p><%= request_record.details %></p></div><span class="status-pill"><%= t("trust.statuses.#{request_record.status}") %></span><%= form_with model: [:admin, request_record], class: "trust-review-form" do |form| %><%= form.text_area :resolution_note, rows: 2, maxlength: 2000, placeholder: t("trust.admin.resolution_note") %><div><%= form.button t("trust.admin.review"), name: :decision, value: "review", class: "button button--ghost button--small" %><%= form.button t("trust.admin.complete"), name: :decision, value: "complete", class: "button button--dark button--small" %><%= form.button t("trust.admin.reject"), name: :decision, value: "reject", class: "button button--ghost button--small" %></div><% end %></article><% end %></div>
    <% else %><p class="muted-copy"><%= t("trust.admin.privacy_requests.empty") %></p><% end %>
  </section>
</main>
