<% content_for :title, t("mfa.setup.title") %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<div class="new-assignment shell mfa-page">
  <div class="new-assignment__intro">
    <h1><%= t("mfa.setup.heading") %></h1>
    <p><%= t("mfa.setup.lede") %></p>
  </div>

  <div class="new-assignment__layout auth-form-layout">
    <%= form_with url: admin_mfa_setup_path, method: :post, class: "assignment-form" do |form| %>
      <fieldset class="form-section">
        <legend><%= t("mfa.setup.secret_legend") %></legend>
        <p><%= t("mfa.setup.secret_instruction") %></p>
        <%= image_tag @qr_code, alt: t("mfa.setup.qr_alt"), class: "mfa-qr", width: 280, height: 280 %>
        <details class="mfa-manual">
          <summary><%= t("mfa.setup.manual_summary") %></summary>
          <code class="mfa-secret"><%= @secret %></code>
          <details><summary><%= t("mfa.setup.uri_summary") %></summary><code class="mfa-uri"><%= @provisioning_uri %></code></details>
        </details>
      </fieldset>
      <fieldset class="form-section">
        <legend><%= t("mfa.setup.confirm_legend") %></legend>
        <div class="field-group"><%= form.label :mfa_code, t("mfa.code_label") %><%= form.text_field :mfa_code, inputmode: "numeric", autocomplete: "one-time-code", maxlength: 8, required: true %><p class="field-hint"><%= t("mfa.code_hint") %></p></div>
      </fieldset>
      <div class="form-actions"><%= form.submit t("mfa.setup.submit"), class: "button button--dark" %></div>
    <% end %>
  </div>
</div>
