<% content_for :title, t("mfa.challenge.title") %>
<main class="new-assignment shell">
  <div class="new-assignment__intro">
    <p class="eyebrow"><%= t("mfa.eyebrow") %></p>
    <h1><%= t("mfa.challenge.heading") %></h1>
    <p><%= t("mfa.challenge.lede") %></p>
  </div>

  <div class="new-assignment__layout">
    <%= form_with url: admin_mfa_challenge_path, method: :post, class: "assignment-form" do |form| %>
      <fieldset class="form-section">
        <legend><%= t("mfa.challenge.legend") %></legend>
        <div class="field-group"><%= form.label :mfa_code, t("mfa.code_label") %><%= form.text_field :mfa_code, inputmode: "numeric", autocomplete: "one-time-code", maxlength: 8, required: true, autofocus: true %><p class="field-hint"><%= t("mfa.code_hint") %></p></div>
      </fieldset>
      <div class="form-actions"><%= form.submit t("mfa.challenge.submit"), class: "button button--dark" %></div>
    <% end %>
    <aside class="posting-aside"><span class="posting-aside__number">01</span><h2><%= t("mfa.challenge.aside_title") %></h2><p><%= t("mfa.challenge.aside_body") %></p></aside>
  </div>
</main>
