<% content_for :title, t("admin.verifications.title") %>
<div class="dashboard-page shell">
  <div class="dashboard-heading">
    <div>
      <h1><%= t("admin.verifications.title") %></h1>
      <p><%= t("admin.verifications.intro") %></p>
    </div>
    <div class="form-actions">
      <% if platform_billing_enabled? %><%= link_to t("admin.founding_accesses.link"), admin_founding_accesses_path, class: "button button--ghost" %><% end %>
      <%= link_to t("admin.users.actions.back"), admin_users_path, class: "button button--ghost" %>
    </div>
  </div>

  <% if @users.any? %>
    <div class="assignment-list">
      <% @users.each do |user| %>
        <% profile = user.lawyer_profile %>
        <article class="dashboard-panel">
          <div class="panel-heading">
            <div>
              <p class="eyebrow"><%= t("admin.verifications.account") %></p>
              <h2><%= user.full_name %></h2>
            </div>
            <span class="status-pill"><%= user.email_verified? ? t("admin.verifications.email_verified") : t("admin.verifications.email_unverified") %></span>
          </div>

          <dl class="detail-facts">
            <div><dt><%= t("admin.verifications.email") %></dt><dd><%= user.email_address %></dd></div>
            <div><dt><%= t("admin.verifications.bar") %></dt><dd><%= [profile&.bar_association, profile&.bar_number].compact_blank.join(" · ").presence || "—" %></dd></div>
            <div><dt><%= t("admin.verifications.lawyer_status") %></dt><dd><%= profile ? t("admin.users.verification.#{profile.verification_status}") : t("admin.verifications.missing") %></dd></div>
          </dl>

          <% if profile&.email_review_status.present? %>
            <% review_state = profile.email_review_status == "approved" && !profile.email_review_approved? ? "changed" : profile.email_review_status %>
            <p><strong><%= t("email_access.admin.title") %>:</strong> <%= t("email_access.admin.states.#{review_state}") %></p>
            <p><%= link_to t("email_access.admin.review"), admin_email_review_path(user), class: "text-link" %></p>
            <% unless profile.email_review_approved? %><p class="field-hint"><%= t("email_access.admin.use_review") %></p><% end %>
          <% end %>

          <%= form_with url: admin_verification_path(user), method: :patch, scope: :verification, namespace: dom_id(user), class: "assignment-form" do |form| %>
            <div class="field-group">
              <%= form.label :note, t("admin.verifications.note") %>
              <%= form.text_area :note, rows: 3, maxlength: 2_000, placeholder: t("admin.verifications.note_placeholder"), value: profile&.verification_note %>
            </div>
            <div class="form-actions">
              <%= form.button t("admin.verifications.reject"), name: "decision", value: "reject", class: "button button--ghost" %>
              <% unless profile&.email_review_status.present? && !profile.email_review_approved? %>
                <%= form.button t("admin.verifications.approve"), name: "decision", value: "approve", class: "button button--dark" %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <section class="empty-state">
      <h2><%= t("admin.verifications.empty_title") %></h2>
    </section>
  <% end %>
</div>
