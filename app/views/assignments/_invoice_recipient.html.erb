<section class="detail-section assignment-invoice-recipient">
  <h2><%= t("assignment_billing.heading") %></h2>
  <% if assignment.invoice_name.present? %>
    <dl class="detail-facts">
      <div><dt><%= t("assignment_billing.name") %></dt><dd><%= assignment.invoice_name %></dd></div>
      <% if assignment.invoice_enterprise_number.present? %><div><dt><%= t("assignment_billing.enterprise_number") %></dt><dd><%= assignment.invoice_enterprise_number %></dd></div><% end %>
      <% if assignment.invoice_details_visible_to?(current_user) %>
        <div><dt><%= t("assignment_billing.email") %></dt><dd><%= mail_to assignment.invoice_email if assignment.invoice_email.present? %></dd></div>
        <div><dt><%= t("assignment_billing.address") %></dt><dd><%= assignment.invoice_address_line_1 %><br><%= [assignment.invoice_postal_code, assignment.invoice_city].compact_blank.join(" ") %></dd></div>
      <% else %>
        <div><dt><%= t("assignment_billing.details") %></dt><dd><%= t("assignment_billing.after_agreement") %></dd></div>
      <% end %>
    </dl>
  <% else %>
    <p><%= t("assignment_billing.legacy") %></p>
  <% end %>
</section>
