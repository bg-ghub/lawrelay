<div class="assignment-detail shell">
  <nav class="breadcrumbs" aria-label="<%= t("marketplace.show.breadcrumb_aria") %>">
    <%= link_to t("marketplace.show.assignments"), assignments_path %><span aria-hidden="true">/</span><span><%= @assignment.kind_label %></span>
  </nav>

  <div class="detail-grid">
    <article class="detail-main">
      <div class="detail-kicker">
        <span class="assignment-kind"><%= @assignment.kind_label %></span>
        <span class="status-pill"><%= t("marketplace.status.#{@assignment.status}") %></span>
      </div>
      <h1><%= @assignment.title %></h1>
      <p class="detail-intro"><%= @assignment.description %></p>

      <section class="detail-section">
        <h2><%= t("marketplace.show.summary_title") %></h2>
        <dl class="detail-facts">
          <div><dt><%= @assignment.court_replacement? ? t("marketplace.show.hearing_at") : t("marketplace.show.execution_deadline") %></dt><dd><%= l @assignment.starts_at, format: "%d/%m/%Y · %H:%M" %></dd></div>
          <div><dt><%= t("marketplace.show.response_deadline") %></dt><dd><%= l @assignment.response_deadline_at, format: "%d/%m/%Y · %H:%M" %></dd></div>
          <% if @assignment.court_replacement? %>
            <% hearing_details = assignment_hearing_details(@assignment) %>
            <div><dt><%= t("marketplace.show.duration") %></dt><dd><%= t("marketplace.show.duration_value", count: @assignment.duration_minutes) %></dd></div>
            <% if hearing_details[:court].present? %><div><dt><%= t("marketplace.show.court") %></dt><dd><%= hearing_details[:court] %></dd></div><% end %>
            <% if hearing_details[:location].present? %><div><dt><%= t("marketplace.show.location") %></dt><dd><%= hearing_details[:location] %><% if hearing_details[:address_unavailable] %><small class="field-hint"><%= t("marketplace.show.address_unavailable") %></small><% end %></dd></div><% end %>
          <% elsif @assignment.delivery_due_at.present? %>
            <div><dt><%= t("marketplace.show.delivery_due") %></dt><dd><%= l @assignment.delivery_due_at, format: "%d/%m/%Y · %H:%M" %></dd></div>
          <% end %>
          <div><dt><%= t("marketplace.show.practice_area") %></dt><dd><%= practice_area_label(@assignment.practice_area) %></dd></div>
          <% if @assignment.legal_task? %>
            <div><dt><%= t("marketplace.show.languages") %></dt><dd><%= @assignment.languages.presence || t("marketplace.show.languages_fallback") %></dd></div>
            <% if @assignment.scope_indication.present? %><div><dt><%= t("marketplace.show.scope_indication") %></dt><dd><%= @assignment.scope_indication %></dd></div><% end %>
          <% end %>
        </dl>
      </section>

      <p class="field-hint"><%= t("company_minimization.private_invoice_details") %></p>

      <% if @owner_view && @assignment.status.in?(%w[open matched]) %>
        <div class="detail-actions">
          <% if @assignment.status == "matched" %>
            <%= button_to t("workflow.ui.complete_assignment"), complete_assignment_path(@assignment), method: :patch, class: "button button--dark" %>
          <% end %>
          <%= button_to t("workflow.ui.cancel_assignment"), cancel_assignment_path(@assignment), method: :patch, class: "button button--ghost", form: { data: { turbo_confirm: t("workflow.ui.cancel_confirm") } } %>
        </div>
      <% end %>
      <% unless @owner_view %>
        <p class="assignment-report-link"><%= link_to t("trust.reports.new.heading"), new_assignment_report_path(@assignment), class: "text-link" %></p>
      <% end %>
    </article>

    <aside class="proposal-panel" id="respond">
      <div class="proposal-panel__price"><span><%= t("marketplace.show.guideline_rate") %></span><strong><%= @assignment.fee_cents.nil? ? t("marketplace.fee_unspecified") : "€ #{euro_amount(@assignment.fee_cents)}" %></strong></div>

      <% if @owner_view %>
        <h2><%= t("workflow.ui.candidates") %></h2>
        <% if @proposals.any? %>
          <div class="candidate-proposals">
            <% @proposals.each do |proposal| %>
              <article class="candidate-proposal">
                <header class="candidate-proposal__header"><strong><%= proposal.display_name %></strong><span class="status-pill"><%= t("marketplace.status.#{proposal.status}") %></span></header>
                <p class="candidate-proposal__message"><%= proposal.message %></p>
                <%= render "proposal_offer", proposal: proposal %>
                <%= render "proposal_location", proposal: proposal %>
                <% if proposal.status == "accepted" && (contact_email = proposal.contact_email).present? %>
                  <p class="contact-card"><%= mail_to contact_email %></p>
                <% elsif proposal.status == "pending" && @assignment.status == "open" && @assignment.starts_at > Time.current %>
                  <div class="proposal-actions">
                    <%= button_to t("workflow.ui.accept"), accept_assignment_proposal_path(@assignment, proposal), method: :patch, class: "button button--coral button--small" %>
                    <%= button_to t("workflow.ui.decline"), decline_assignment_proposal_path(@assignment, proposal), method: :patch, class: "button button--ghost button--small" %>
                  </div>
                <% end %>
              </article>
            <% end %>
          </div>
        <% else %>
          <p><%= t("workflow.ui.no_candidates") %></p>
        <% end %>
      <% elsif @existing_proposal %>
        <h2><%= t("workflow.ui.your_proposal") %></h2>
        <article class="candidate-proposal candidate-proposal--own">
          <header class="candidate-proposal__header"><span class="status-pill"><%= t("marketplace.status.#{@existing_proposal.status}") %></span></header>
          <p class="candidate-proposal__message"><%= @existing_proposal.message %></p>
          <%= render "proposal_offer", proposal: @existing_proposal %>
          <%= render "proposal_location", proposal: @existing_proposal %>
          <% if @existing_proposal.status == "accepted" %>
            <% if (contact_email = @assignment.creator_user&.marketplace_contact_email).present? %>
              <p class="contact-card"><%= mail_to contact_email %></p>
            <% end %>
          <% elsif @existing_proposal.status == "pending" %>
            <%= button_to t("workflow.ui.withdraw"), withdraw_assignment_proposal_path(@assignment, @existing_proposal), method: :patch, class: "button button--ghost button--full" %>
          <% end %>
        </article>
      <% elsif @assignment.accepting_proposals? %>
        <h2><%= t("marketplace.show.interested_title") %></h2>
        <p><%= t("marketplace.show.interested_body") %></p>
        <%= form_with model: [@assignment, @proposal], class: "proposal-form" do |form| %>
          <% if @proposal.errors.any? %><div class="form-error" role="alert" tabindex="-1" data-controller="form-errors"><strong><%= t("marketplace.show.proposal_error_heading") %></strong><ul><% @proposal.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
          <div class="form-row"><div class="field-group"><%= form.label :rate_kind, t("marketplace.show.rate_kind_label") %><%= searchable_select form, :rate_kind, Proposal::RATE_KINDS.map { |kind| [ t("marketplace.rate_kinds.#{kind}"), kind ] }, {}, class: "select-field" %></div><div class="field-group"><%= form.label :rate_cents, t("marketplace.show.rate_label") %><%= form.number_field :rate_cents, min: 0, step: 0.01, value: euro_amount(@proposal.rate_cents || @assignment.fee_cents, field: true), required: true %><p class="field-hint"><%= t("marketplace.show.rate_hint") %></p></div></div>
          <%= render "assignments/proposal_travel_fields", form: form, proposal: @proposal if @assignment.court_replacement? %>
          <div class="field-group"><%= form.label :message, t("marketplace.show.message_label") %><%= form.text_area :message, rows: 4, required: true, maxlength: 2000, placeholder: t("marketplace.show.message_placeholder") %></div>
          <%= form.submit t("marketplace.show.submit"), class: "button button--coral button--full" %>
        <% end %>
        <p class="privacy-note"><span aria-hidden="true">⌘</span> <%= t("marketplace.show.privacy_note") %></p>
      <% else %>
        <h2><%= t("workflow.ui.closed") %></h2>
        <p><%= t("workflow.ui.closed_body") %></p>
      <% end %>
    </aside>
  </div>
</div>
