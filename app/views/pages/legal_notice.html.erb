<% content_for :title, t("pages.legal_notice.meta_title") %>
<section class="marketplace-page">
  <div class="shell">
    <%= render "pages/navigation" %>
    <header class="marketplace-hero">
      <div>
        <p class="eyebrow"><%= t("pages.legal_notice.eyebrow") %></p>
        <h1><%= t("pages.legal_notice.title") %></h1>
        <p class="lede"><%= t("pages.legal_notice.introduction") %></p>
        <p class="result-meta__note"><%= t("pages.shared.version", date: @legal_version) %></p>
      </div>
    </header>

    <%= render "pages/operator_warning" %>

    <article class="dashboard-panel">
      <dl class="detail-facts">
        <% PagesController::OPERATOR_ENV.each_key do |field| %>
          <div>
            <dt><%= t("pages.legal_notice.fields.#{field}") %></dt>
            <dd>
              <% value = @operator[field] %>
              <% if field == :professional_rules_url && value.present? %>
                <%= link_to value, value, rel: "noopener" %>
              <% else %>
                <%= value.presence || t("pages.shared.not_configured") %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>

      <% t("pages.legal_notice.sections").each_value do |section| %>
        <section class="detail-section">
          <h2><%= section[:heading] %></h2>
          <% Array(section[:paragraphs]).each do |paragraph| %><p><%= paragraph %></p><% end %>
        </section>
      <% end %>
    </article>
  </div>
</section>
