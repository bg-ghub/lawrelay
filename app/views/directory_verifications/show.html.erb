<section class="new-assignment shell">
  <div class="dashboard-panel">
    <p class="eyebrow"><%= t("directory_mail.page.eyebrow") %></p>
    <h1><%= t("directory_mail.page.heading") %></h1>
    <p><%= t("directory_mail.page.body", name: @user.full_name, login_email: @user.email_address) %></p>
    <p><%= t("directory_mail.page.notice") %></p>

    <%= button_to t("directory_mail.page.action"), confirm_directory_verification_path(token: params[:token], locale: @user.locale), method: :post, class: "button button-dark" %>
  </div>
</section>
