<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <meta name="robots" content="<%= public_marketing_page? ? "index,follow" : "noindex,nofollow" %>">
    <% if public_marketing_page? %>
      <link rel="canonical" href="<%= localized_canonical_url(I18n.locale) %>">
      <% I18n.available_locales.each do |locale| %>
        <link rel="alternate" hreflang="<%= locale %>" href="<%= localized_canonical_url(locale) %>">
      <% end %>
      <link rel="alternate" hreflang="x-default" href="<%= localized_canonical_url(:en) %>">
      <meta property="og:type" content="website">
      <meta property="og:site_name" content="LawRelay">
      <meta property="og:locale" content="<%= social_preview_locale %>">
      <% I18n.available_locales.excluding(I18n.locale).each do |locale| %>
        <meta property="og:locale:alternate" content="<%= social_preview_locale(locale) %>">
      <% end %>
      <meta property="og:title" content="<%= page_title %>">
      <meta property="og:description" content="<%= page_description %>">
      <meta property="og:url" content="<%= localized_canonical_url(I18n.locale) %>">
      <meta property="og:image" content="<%= social_preview_image_url %>">
      <meta property="og:image:secure_url" content="<%= social_preview_image_url %>">
      <meta property="og:image:type" content="image/png">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:image:alt" content="<%= t("marketing.home.social_preview.alt") %>">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content="<%= page_title %>">
      <meta name="twitter:description" content="<%= page_description %>">
      <meta name="twitter:image" content="<%= social_preview_image_url %>">
      <meta name="twitter:image:alt" content="<%= t("marketing.home.social_preview.alt") %>">
    <% end %>
    <meta name="theme-color" content="#173f3b">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LawRelay">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site-shell">
    <a class="skip-link" href="#main-content" data-turbo="false"><%= t("marketing.layout.skip_to_content") %></a>
    <% if admin_host? %>
      <%= render "admin/shared/header" %>
    <% else %>
      <%= render "shared/product_bar" %>
      <%= render "shared/header" %>
    <% end %>
    <% if flash.any? %>
      <div class="flash-stack" aria-live="polite" aria-atomic="true">
        <% flash.each do |type, message| %>
          <div class="flash-message flash-message--<%= type %>" data-controller="flash" role="<%= type.to_s == "alert" ? "alert" : "status" %>">
            <span><%= message %></span>
            <button class="flash-dismiss" type="button" aria-label="<%= t("marketing.layout.dismiss_notice") %>" data-action="flash#close">×</button>
          </div>
        <% end %>
      </div>
    <% end %>
    <main id="main-content" tabindex="-1">
      <% if controller_path.start_with?("admin/") && current_user&.system_admin? && Current.session&.admin_mfa_verified? %>
        <%= render "admin/shared/navigation" %>
      <% end %>
      <%= yield %>
    </main>
    <%= render(admin_host? ? "admin/shared/footer" : "shared/footer") %>
  </body>
</html>
