<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("marketing.layout.title") %></title>
    <meta name="description" content="<%= t("marketing.layout.description") %>">
    <meta name="robots" content="<%= public_marketing_page? ? "index,follow" : "noindex,nofollow" %>">
    <% if public_marketing_page? %>
      <link rel="canonical" href="<%= localized_canonical_url(I18n.locale) %>">
      <% I18n.available_locales.each do |locale| %>
        <link rel="alternate" hreflang="<%= locale %>" href="<%= localized_canonical_url(locale) %>">
      <% end %>
      <link rel="alternate" hreflang="x-default" href="<%= localized_canonical_url(:en) %>">
    <% end %>
    <meta name="theme-color" content="#173f3b">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LawRelay">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site-shell">
    <a class="skip-link" href="#main-content" data-turbo="false"><%= t("marketing.layout.skip_to_content") %></a>
    <%= render "shared/header" %>
    <% if flash.any? %>
      <div class="flash-stack" aria-live="polite" aria-atomic="true">
        <% flash.each do |type, message| %>
          <div class="flash-message flash-message--<%= type %>" data-controller="flash" role="<%= type.to_s == "alert" ? "alert" : "status" %>">
            <span><%= message %></span>
            <button class="flash-dismiss" type="button" aria-label="<%= t("marketing.layout.dismiss_notice") %>" data-action="flash#close">×</button>
          </div>
        <% end %>
      </div>
    <% end %>
    <main id="main-content" tabindex="-1">
      <% if controller_path.start_with?("admin/") && current_user&.system_admin? && Current.session&.admin_mfa_verified? %>
        <%= render "admin/shared/navigation" %>
      <% end %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
