<div class="field-group">
  <%= form.label :mfa_code, t("two_factor.code_label") %>
  <%= form.text_field :mfa_code, inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6, pattern: "[0-9]{6}", autofocus: local_assigns.fetch(:autofocus, false) %>
</div>
<details class="mfa-manual">
  <summary><%= t("two_factor.recovery_summary") %></summary>
  <div class="field-group">
    <%= form.label :recovery_code, t("two_factor.recovery_code_label") %>
    <%= form.text_field :recovery_code, autocomplete: "off", autocapitalize: "characters", spellcheck: false, maxlength: 64 %>
  </div>
</details>
<p class="field-hint"><%= t("two_factor.code_or_recovery_hint") %></p>
