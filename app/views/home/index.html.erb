<% content_for :title, t("marketing.home.title") %>
<% content_for :meta_description, t("marketing.home.og_description") %>

<section class="hero-section">
  <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <h1><%= t("marketing.home.hero.heading_before") %><br><%= t("marketing.home.hero.heading_middle") %> <em><%= t("marketing.home.hero.heading_emphasis") %></em></h1>
      <p class="hero-lede"><%= t("marketing.home.hero.lede") %></p>
      <div class="hero-actions">
        <%= link_to new_assignment_path, class: "button button-coral" do %><span><%= t("marketing.actions.post_assignment") %></span><span aria-hidden="true">→</span><% end %>
        <%= link_to assignments_path, class: "text-link text-link-light" do %><span><%= t("marketing.actions.browse_assignments") %></span><span aria-hidden="true">↗</span><% end %>
      </div>
    </div>

    <div class="hero-product" role="group" aria-label="<%= t("marketing.home.product.aria_label") %>">
      <p class="hero-product__label"><%= t("marketing.home.product.example_label") %></p>
      <div class="hero-assignment-preview">
        <%= render "assignments/card", assignment: home_preview_assignment, preview: true %>
      </div>
    </div>
  </div>
</section>

<section class="pathways-section" id="for-lawyers">
  <div class="shell">
    <div class="pathway-grid">
      <%= link_to new_assignment_path, class: "pathway-card pathway-card-paper" do %>
        <div class="pathway-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6zM14 3v5h5M9 13h6M9 17h4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></div>
        <h2><%= t("marketing.home.pathways.requester.heading_before") %><br><%= t("marketing.home.pathways.requester.heading_after") %></h2><p><%= t("marketing.home.pathways.requester.body") %></p>
        <span class="card-link"><span><%= t("marketing.actions.post_assignment") %></span><span aria-hidden="true">→</span></span>
      <% end %>
      <%= link_to assignments_path, class: "pathway-card pathway-card-ink" do %>
        <div class="pathway-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16M13 5l7 7-7 7M4 6h5M4 18h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h2><%= t("marketing.home.pathways.responder.heading_before") %><br><%= t("marketing.home.pathways.responder.heading_after") %></h2><p><%= t("marketing.home.pathways.responder.body") %></p>
        <span class="card-link"><span><%= t("marketing.actions.browse_assignments") %></span><span aria-hidden="true">→</span></span>
      <% end %>
    </div>
  </div>
</section>

<section class="opportunities-section" id="assignments">
  <div class="shell">
    <div class="section-heading opportunities-heading"><h2><%= t("marketing.home.opportunities.eyebrow") %></h2><%= link_to assignments_path, class: "text-link text-link-dark" do %><span><%= t("marketing.home.opportunities.all") %></span><span aria-hidden="true">↗</span><% end %></div>
    <div class="opportunity-grid">
      <% if @featured_assignments.present? %>
        <% @featured_assignments.each do |assignment| %>
          <%= link_to assignment_path(assignment), class: "opportunity-card" do %>
            <div class="opportunity-meta"><span class="tag <%= assignment.kind == "court_replacement" ? "tag-coral" : "tag-mint" %>"><%= assignment.kind_label %></span><span><%= assignment.starts_at ? l(assignment.starts_at, format: :short) : t("marketing.home.opportunities.by_arrangement") %></span></div>
            <h3><%= assignment.title %></h3><p><span aria-hidden="true">◎</span> <%= [assignment.court, assignment.city].compact_blank.join(" · ").presence || t("marketing.home.opportunities.belgium") %></p><div class="opportunity-bottom"><span><%= assignment.practice_area %></span><strong><%= t("marketing.actions.view") %> <span aria-hidden="true">→</span></strong></div>
          <% end %>
        <% end %>
      <% else %>
        <div class="empty-opportunities"><h3><%= t("marketing.home.opportunities.empty_heading") %></h3><p><%= t("marketing.home.opportunities.empty_body") %></p><%= link_to t("marketing.actions.post_assignment"), new_assignment_path, class: "text-link text-link-light" %></div>
      <% end %>
    </div>
    <p class="demo-caption"><%= t("marketing.home.opportunities.demo_caption") %></p>
  </div>
</section>

<section class="how-section" id="how-it-works">
  <div class="shell how-grid">
    <div class="how-intro"><h2><%= t("marketing.header.how_it_works") %></h2></div>
    <ol class="steps-list">
      <% 3.times do |index| %>
        <li><span class="step-number"><%= format("%02d", index + 1) %></span><div><h3><%= t("marketing.home.how.steps.#{index}.heading") %></h3><p><%= t("marketing.home.how.steps.#{index}.body") %></p></div></li>
      <% end %>
    </ol>
  </div>
</section>

<section class="faq-section" id="questions">
  <div class="shell faq-grid">
    <div><h2><%= t("marketing.header.questions") %></h2></div>
    <div class="faq-list">
      <% 4.times do |index| %>
        <details <%= "open" if index.zero? %>><summary><%= t("marketing.home.faq.items.#{index}.question") %><span aria-hidden="true">+</span></summary><p><%= t("marketing.home.faq.items.#{index}.answer") %></p></details>
      <% end %>
    </div>
  </div>
</section>
