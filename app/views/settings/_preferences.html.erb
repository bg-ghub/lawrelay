<fieldset class="form-section profile-preferences">
  <legend><%= t("settings.preferences.legend") %></legend>
  <p class="field-hint"><%= t("settings.preferences.introduction") %></p>
  <div class="field-group">
    <%= form.label "preferences[bar_admission_year]", t("settings.profile.bar_admission_year") %>
    <%= form.number_field "preferences[bar_admission_year]", value: profile.bar_admission_year, min: 1900, max: Time.current.year, step: 1, placeholder: t("settings.profile.bar_admission_year_placeholder"), class: "profile-preferences__year" %>
  </div>
</fieldset>
