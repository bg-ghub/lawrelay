<% content_for :title, t("settings.title") %>
<div class="new-assignment shell settings-page">
  <div class="new-assignment__intro">
    <h1><%= t("settings.heading") %></h1>
  </div>

  <div class="new-assignment__layout">
    <div class="assignment-form settings-panels">
    <%= form_with url: settings_path, method: :patch, class: "assignment-form", data: { unsaved_changes: false } do |form| %>
      <% errors = [@user, @profile].flat_map { |record| record.errors.full_messages }.uniq %>
      <% if errors.any? %>
        <div class="form-error" role="alert" tabindex="-1" data-controller="form-errors">
          <strong><%= t("settings.errors.heading") %></strong>
          <ul><% errors.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>

      <fieldset class="form-section">
        <legend><%= t("settings.account.legend") %></legend>
        <div class="field-group"><strong><%= t("auth.fields.professional_email") %></strong><p><%= @user.email_address %></p><% unless @user.system_admin? %><p><%= mail_to email_change_support_address, t("email_change.link"), subject: t("email_change.link"), class: "text-link" %></p><% end %></div>
        <div class="field-group"><%= form.label "account[locale]", t("settings.account.language") %><%= searchable_select form, "account[locale]", [["Nederlands", "nl"], ["Français", "fr"], ["Deutsch", "de"], ["English", "en"]], { selected: @user.locale }, class: "select-field" %></div>
      </fieldset>

      <%= render "preferences", form: form, profile: @profile unless @user.system_admin? %>

      <% unless @user.system_admin? %>
        <fieldset class="form-section" id="email-notifications">
          <legend><%= t("settings.notifications.legend") %></legend>
          <label class="form-check">
            <%= form.check_box "account[new_assignment_alerts]", checked: @user.new_assignment_alerts? %>
            <span><%= t("settings.notifications.new_assignment_alerts") %></span>
          </label>
          <label class="form-check">
            <%= form.check_box "account[assignment_update_emails]", checked: @user.assignment_update_emails? %>
            <span><%= t("settings.notifications.assignment_update_emails") %></span>
          </label>
          <p class="field-hint"><%= t("settings.notifications.security_email_hint") %></p>
        </fieldset>
      <% end %>

      <div class="form-actions"><%= link_to t("trust.privacy_requests.index.heading"), privacy_requests_path, class: "button button--ghost" %><%= form.submit t("settings.save"), class: "button button--dark" %></div>
    <% end %>

    <%= render "directory_profile", profile: @profile, user: @user %>
    </div>

  </div>

  <% unless @user.system_admin? %>
    <section class="form-section two-factor-settings" aria-labelledby="account-security-heading">
      <h2 id="account-security-heading"><%= t("two_factor.settings.heading") %></h2>
      <p><%= t(@user.two_factor_enabled? ? "two_factor.settings.status_on" : "two_factor.settings.status_off") %></p>
      <%= link_to t("two_factor.settings.manage"), two_factor_authentication_path, class: "text-link" %>
    </section>
    <section class="form-section two-factor-settings" aria-labelledby="account-deletion-heading">
      <h2 id="account-deletion-heading"><%= t("account_deletion.settings.heading") %></h2>
      <p><%= t("account_deletion.settings.body") %></p>
      <%= link_to t("account_deletion.settings.link"), account_deletion_path, class: "text-link" %>
    </section>
  <% end %>
</div>
