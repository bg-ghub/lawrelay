<% content_for :title, t("settings.title") %>
<div class="new-assignment shell settings-page">
  <div class="new-assignment__intro">
    <h1><%= t("settings.heading") %></h1>
  </div>

  <div class="new-assignment__layout">
    <div class="assignment-form settings-panels">
    <%= form_with url: settings_path, method: :patch, class: "assignment-form", data: { unsaved_changes: false } do |form| %>
      <% errors = [@user, @profile].flat_map { |record| record.errors.full_messages }.uniq %>
      <% if errors.any? %>
        <div class="form-error" role="alert" tabindex="-1" data-controller="form-errors">
          <strong><%= t("settings.errors.heading") %></strong>
          <ul><% errors.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>

      <fieldset class="form-section">
        <legend><%= t("settings.account.legend") %></legend>
        <div class="form-row">
          <div class="field-group"><%= form.label "account[first_name]", t("auth.fields.first_name") %><%= form.text_field "account[first_name]", value: @user.first_name, required: true, autocomplete: "given-name" %></div>
          <div class="field-group"><%= form.label "account[last_name]", t("auth.fields.last_name") %><%= form.text_field "account[last_name]", value: @user.last_name, required: true, autocomplete: "family-name" %></div>
        </div>
        <div class="field-group"><strong><%= t("auth.fields.professional_email") %></strong><p><%= @user.email_address %></p><% unless @user.system_admin? %><p><%= link_to t("email_change.link"), email_change_path, class: "text-link" %></p><% end %></div>
        <div class="field-group"><%= form.label "account[locale]", t("settings.account.language") %><%= searchable_select form, "account[locale]", [["Nederlands", "nl"], ["Français", "fr"], ["Deutsch", "de"], ["English", "en"]], { selected: @user.locale }, class: "select-field" %></div>
      </fieldset>

      <div class="form-actions"><%= link_to t("trust.privacy_requests.index.heading"), privacy_requests_path, class: "button button--ghost" %><%= form.submit t("settings.save"), class: "button button--dark" %></div>
    <% end %>

    <section class="form-section directory-profile" aria-labelledby="directory-profile-heading">
      <h2 id="directory-profile-heading"><%= t("settings.profile.legend") %></h2>
      <p class="field-hint"><%= t("profile_import.scope") %></p>
      <% if @profile.spoken_languages.any? || @profile.practice_areas.any? %>
        <dl class="detail-facts directory-profile__facts">
          <% if @profile.spoken_languages.any? %><div><dt><%= t("settings.profile.languages") %></dt><dd><%= @profile.spoken_languages.join(", ") %></dd></div><% end %>
          <% if @profile.practice_areas.any? %><div><dt><%= t("settings.profile.practice_areas") %></dt><dd><%= @profile.practice_areas.join(", ") %></dd></div><% end %>
        </dl>
      <% end %>
      <% if @profile.directory_profile_url.present? %>
        <p><%= link_to t("directory_onboarding.settings.open_directory_profile"), @profile.directory_profile_url, target: "_blank", rel: "noopener noreferrer", class: "text-link" %></p>
        <% unless @user.system_admin? %>
          <p class="field-hint" id="profile-refresh-hint"><%= t("profile_import.manual_hint") %></p>
          <%= form_with url: settings_path, method: :patch, class: "profile-refresh-form" do |form| %>
            <%= form.button t("profile_import.button"), name: "settings_action", value: "refresh_profile", class: "button button--dark profile-import-button", aria: { describedby: "profile-refresh-hint" }, data: { turbo_submits_with: t("profile_import.refreshing") } %>
          <% end %>
        <% end %>
      <% else %>
        <p><%= t("profile_import.missing_profile") %></p>
      <% end %>
    </section>
    </div>

  </div>

  <% unless @user.system_admin? %>
    <section class="form-section two-factor-settings" aria-labelledby="account-security-heading">
      <h2 id="account-security-heading"><%= t("two_factor.settings.heading") %></h2>
      <p><%= t(@user.two_factor_enabled? ? "two_factor.settings.status_on" : "two_factor.settings.status_off") %></p>
      <%= link_to t("two_factor.settings.manage"), two_factor_authentication_path, class: "text-link" %>
    </section>
    <section class="form-section two-factor-settings" aria-labelledby="account-deletion-heading">
      <h2 id="account-deletion-heading"><%= t("account_deletion.settings.heading") %></h2>
      <p><%= t("account_deletion.settings.body") %></p>
      <%= link_to t("account_deletion.settings.link"), account_deletion_path, class: "text-link" %>
    </section>
  <% end %>
</div>
