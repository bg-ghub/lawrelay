<div class="dashboard-page shell">
  <div class="dashboard-heading"><div><p class="eyebrow"><%= t("marketplace.dashboard.eyebrow") %></p><h1><%= t("marketplace.dashboard.title") %></h1><p><%= t("marketplace.dashboard.lede") %></p></div><div class="dashboard-actions"><% if current_user.firm_administrator? %><%= link_to t("billing.eyebrow"), billing_path, class: "button button--ghost" %><% end %><% if current_user.system_admin? %><%= link_to t("admin.verifications.eyebrow"), admin_verifications_path, class: "button button--ghost" %><%= link_to t("trust.admin.eyebrow"), admin_reports_path, class: "button button--ghost" %><% end %><%= link_to new_assignment_path, class: "button button--dark" do %><%= t("marketplace.dashboard.new_assignment") %> <span aria-hidden="true">→</span><% end %></div></div>
  <section class="dashboard-summary" aria-label="<%= t("marketplace.dashboard.summary_aria") %>">
    <div class="summary-card"><span><%= t("marketplace.dashboard.open_assignments") %></span><strong><%= @open_assignments.size %></strong><small><%= t("marketplace.dashboard.open_assignments_hint") %></small></div>
    <div class="summary-card"><span><%= t("workflow.ui.your_proposals") %></span><strong><%= @recent_proposals.size %></strong><small><%= t("workflow.ui.your_proposals_hint") %></small></div>
    <div class="summary-card"><span><%= t("marketplace.dashboard.next_hearing") %></span><strong><%= @assignments.minimum(:starts_at) ? l(@assignments.minimum(:starts_at), format: "%d/%m") : "—" %></strong><small><%= t("marketplace.dashboard.next_hearing_hint") %></small></div>
  </section>
  <div class="dashboard-grid">
    <section class="dashboard-panel"><div class="panel-heading"><div><p class="eyebrow"><%= t("marketplace.dashboard.your_assignments") %></p><h2><%= t("marketplace.dashboard.recent_posts") %></h2></div><%= link_to t("marketplace.dashboard.view_all"), assignments_path, class: "text-link" %></div>
      <% if @assignments.any? %><div class="compact-list"><% @assignments.first(4).each do |assignment| %><%= link_to assignment_path(assignment), class: "compact-row" do %><span class="compact-row__date"><strong><%= l assignment.starts_at, format: "%d" %></strong><small><%= l assignment.starts_at, format: "%m" %></small></span><span class="compact-row__copy"><strong><%= assignment.title %></strong><small><%= assignment.court.presence || assignment.city %></small></span><span class="status-pill"><%= t("marketplace.status.#{assignment.status}") %></span><span aria-hidden="true">→</span><% end %><% end %></div><% else %><p class="muted-copy"><%= t("marketplace.dashboard.no_assignments") %></p><% end %>
    </section>
    <section class="dashboard-panel dashboard-panel--warm"><div class="panel-heading"><div><p class="eyebrow"><%= t("workflow.ui.your_proposals") %></p><h2><%= t("workflow.ui.recent_responses") %></h2></div></div>
      <% if @recent_proposals.any? %><div class="proposal-list"><% @recent_proposals.each do |proposal| %><article class="proposal-preview"><span class="avatar-mark"><%= proposal.assignment.title.first %></span><div><strong><%= proposal.assignment.title %></strong><p><%= t("marketplace.dashboard.proposed_rate", rate: number_with_delimiter(proposal.rate_cents.to_i / 100)) %> · <%= t("marketplace.status.#{proposal.status}") %></p></div><%= link_to t("marketplace.dashboard.view"), assignment_path(proposal.assignment), class: "text-link" %></article><% end %></div><% else %><p class="muted-copy"><%= t("workflow.ui.no_proposals_yet") %></p><% end %>
    </section>
  </div>
  <% if @suggested_assignments.any? %>
    <section class="dashboard-panel dashboard-panel--warm suggested-assignments">
      <div class="panel-heading"><div><p class="eyebrow"><%= t("marketplace.dashboard.suggestions_eyebrow") %></p><h2><%= t("marketplace.dashboard.suggestions_title") %></h2></div><%= link_to t("marketplace.dashboard.view_all"), assignments_path, class: "text-link" %></div>
      <div class="compact-list"><% @suggested_assignments.each do |assignment| %><%= link_to assignment_path(assignment), class: "compact-row" do %><span class="compact-row__date"><strong><%= l assignment.starts_at, format: "%d" %></strong><small><%= l assignment.starts_at, format: "%m" %></small></span><span class="compact-row__copy"><strong><%= assignment.title %></strong><small><%= assignment.court.presence || assignment.city %></small></span><span class="status-pill"><%= t("marketplace.kinds.#{assignment.kind}") %></span><span aria-hidden="true">→</span><% end %><% end %></div>
    </section>
  <% end %>
  <% if @notifications.any? %>
    <section class="dashboard-panel notification-panel"><div class="panel-heading"><div><p class="eyebrow"><%= t("workflow.ui.notifications") %></p><h2><%= t("workflow.ui.recent_notifications") %></h2></div><%= button_to t("workflow.ui.mark_all_read"), mark_all_notifications_path, method: :patch, class: "text-link notification-mark-all" %></div>
      <ul class="notification-list"><% @notifications.each do |notification| %><li><%= link_to notification_path(notification), class: "notification-list__item" do %><span><%= t("workflow.notifications.#{notification.kind}") %></span><span aria-hidden="true">→</span><% end %></li><% end %></ul>
    </section>
  <% end %>
</div>
