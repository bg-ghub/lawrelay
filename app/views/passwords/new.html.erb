<% content_for :title, t("auth.passwords.new.title") %>
<div class="new-assignment shell">
  <div class="new-assignment__intro">
    <h1><%= t("auth.passwords.new.heading") %></h1>
    <p><%= t("auth.passwords.new.lede") %></p>
  </div>
  <div class="new-assignment__layout auth-form-layout">
    <%= form_with url: passwords_path, class: "assignment-form" do |form| %>
      <fieldset class="form-section" aria-label="<%= t("auth.passwords.new.form_title") %>">
        <div class="field-group">
          <%= form.label :email_address, t("auth.passwords.new.form_title") %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
        </div>
      </fieldset>
      <div class="form-actions">
        <%= link_to t("auth.actions.back_to_sign_in"), authentication_login_path, class: "button button--ghost" %>
        <%= form.submit t("auth.passwords.new.submit"), class: "button button--dark" %>
      </div>
    <% end %>
  </div>
</div>
